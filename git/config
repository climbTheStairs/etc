# Only ever modify master copy on arch:!
[alias]
	c	= commit -m
	ca	= commit -am
	df	= diff --minimal
	dfs	= diff --summary
	dfw	= diff --word-diff=color
	dfw2	= diff --word-diff=plain
	dfww	= dfw  --word-diff-regex="[0-9A-Za-z_]+|."
	dfww2	= dfw2 --word-diff-regex="[0-9A-Za-z_]+|."
	log1	= log --oneline		# show commit msg
	log2	= log1 --name-only	# show commit msg, files
	log3	= log1 --stat		# show commit msg, files, summary o changes
	st	= status --short
	stt	= st --untracked-files=no
[commit]
	gpgsign = true
[core]
	# do not touch line endings on checkout or commit
	# (why is this confusing bloated garbage even a part of git?)
	# instead use hook to stop accidental CRLF
	autocrlf = false
	# WARN: XDG_CONFIG_DIR hardcoded here!
	# TODO
	hooksPath = ~/etc/git/hooks # https://stackoverflow.com/a/37293198
[gpg]
	format = ssh
[init]
	defaultBranch = master
[pull]
	ff = only # https://blog.sffc.xyz/post/185195398930
[user]
	email = yxtqwf+github@gmail.com
	name = climbTheStairs
	signingkey = ~/.ssh/id_ed25519.pub
