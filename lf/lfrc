# Only ever modify master copy on arch:!

## basic (/etc/lf/lfrc)
#set scrolloff 999
set dircounts
set hidden
set icons
set ifs "\n"
set incsearch
set info size
set mouse false
set ratios 1:2
set smartcase
set smartdia
set sortby name
set sortignorecase false
map X :delete
map zb :set drawbox!
map zd :set dirfirst!
map p :paste; clear
map <esc> :clear; unselect

## calxfs
set hiddenfiles .*:*.calx

## unix only
set drawbox
set previewer ~/etc/lf/previewer.sh
&lf -remote "send $id :set previewer $XDG_CONFIG_HOME/lf/previewer.sh"
map q :lfcd_abort
map Q :quit # lfcd: cd par sh into $PWD
map x :${{ rmpty $fx }} # TODO: show err on fail
map R $qmv -f do
map <a-y> :${{ wl-copy -t text/plain "$fx" }}
map <a-6> :${{ chmod 644 -- $fx }}; reload
map <a-5> :${{ trash $fx }}; reload
map <a-s> :${{ trash $fx }}; reload
map <a-n> :${{ chmod 644 -- $fx }}; reload
map <a-x> :${{ chmod +x  -- $fx }}; reload
#map <c-z> $kill -STOP $PPID # TODO: not working, fix
cmd lfcd_abort &lf -remote "send $id :cd $OLDPWD; quit"
cmd _edit ${{
	# TODO: see win lfrc
	if [ -n "$TMUX" ]; then
		tmux {split-window -h,new-window -a} -e EDITOR="$EDITOR" -e f="$f" \
			'"$EDITOR" "$f"'
	else
		"$EDITOR" "$f"
	fi
}}

